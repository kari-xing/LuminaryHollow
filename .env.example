# ========== 心光树洞 LuminaryHollow ==========
# 复制本文件为 .env 并按环境修改
# 后端读取根目录 .env（docker compose）或 backend/.env（本地开发）

# 安全
JWT_SECRET=please-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# 存储连接
DATABASE_URL=postgresql+asyncpg://hollow:hollow@localhost:5432/hollow
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8012

# LLM（provider: ollama 本地 / openai 兼容云端，如 DeepSeek、OpenRouter、通义等）
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5
LLM_API_KEY=
# Embedding 独立配置：云端 API 无 embedding 接口时，向量化走本地 Ollama
EMBED_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# 定时任务
WEEKLY_REPORT_CRON=0 22 * * 0
